#!/usr/bin/env python3

import glob
import json
import os
import re
import subprocess
import sys
from datetime import datetime
from functools import lru_cache
from http.client import HTTPException
from urllib.parse import urlencode, urlsplit
from urllib.request import urlopen

import frontmatter
from markdown_it import MarkdownIt
from mdformat.renderer import MDRenderer

CONFIG = "_data/config.json"


def usage():
    print("Usage: publish [profile|relays|blog|post <filename>]")
    sys.exit(1)


def run(cmd):
    """Run a shell command and return its output (stripped)."""
    return subprocess.check_output(cmd, shell=True, text=True).strip()


def load_config():
    with open(CONFIG, "r", encoding="utf-8") as f:
        return json.load(f)


def get_write_relays(config):
    return [
        relay["url"]
        for relay in config.get("relays", [])
        if relay.get("write", True)
    ]


def publish_profile(config):
    profile = config.get("profile", {})
    created_at = run(f"git log -1 --format=%ct -- {CONFIG}")
    args = ["nak", "event", "--kind", "0", "--created-at", created_at]
    args.extend(["--content", json.dumps(profile, separators=(",", ":"))])

    args += get_write_relays(config)
    subprocess.run(args, stdout=subprocess.DEVNULL)


def publish_relays(config):
    created_at = run(f"git log -1 --format=%ct -- {CONFIG}")
    args = [
        "nak",
        "event",
        "--kind",
        "10002",
        "--created-at",
        created_at,
        "--content",
        "",
    ]
    for relay in config.get("relays", []):
        url = relay.get("url")
        read = relay.get("read", True)
        write = relay.get("write", True)
        if read and write:
            args.append(f"--tag=r={url}")
        elif read:
            args.append(f"--tag=r={url}=read")
        elif write:
            args.append(f"--tag=r={url}=write")

    args += get_write_relays(config)
    subprocess.run(args, stdout=subprocess.DEVNULL)


def event_pointer(entry):
    if not isinstance(entry, dict) or not isinstance(entry.get("filter"), dict):
        return None
    relays = entry.get("relays", [])
    if not isinstance(relays, list) or not all(isinstance(r, str) for r in relays):
        return None
    hex_key = r"[0-9a-f]{64}"
    query = entry["filter"].copy()
    query.pop("limit", None)
    match query:
        case {"ids": [str(event_id)], **extra} if not extra and re.fullmatch(hex_key, event_id):
            pointer = {"id": event_id}
        case {"authors": [str(author)], "kinds": [int(kind)], "#d": [str(slug)], **extra} if (
            not extra and re.fullmatch(hex_key, author) and 30000 <= kind < 40000
        ):
            pointer = {"pubkey": author, "kind": kind, "identifier": slug}
        case _:
            return None
    encoded = subprocess.check_output(
        ["nak", "encode"], input=json.dumps({**pointer, "relays": relays}), text=True
    )
    return "nostr:" + encoded.strip()


@lru_cache(maxsize=1024)
def resolve_link(url):
    try:
        parts = urlsplit(url)
        if parts.scheme not in ("http", "https") or not parts.hostname or parts.username is not None:
            return url
        if parts.query or parts.fragment:
            return url
        path = parts.path or "/"
        endpoint = f"https://{parts.netloc}/.well-known/nostr.json?" + urlencode({"path": path})
        with urlopen(endpoint, timeout=3) as response:
            directory = json.loads(response.read(1024 * 1024 + 1))
        if isinstance(directory, dict):
            return event_pointer(directory.get(path)) or url
    except (OSError, HTTPException, ValueError, subprocess.CalledProcessError):
        pass
    return url


def format_article(content):
    parser = MarkdownIt(renderer_cls=MDRenderer)
    parser.options.update(mdformat={"wrap": "no"}, store_labels=True)
    env = {}
    tokens = parser.parse(content, env)
    for block in tokens:
        for token in block.children or ():
            if token.type == "link_open":
                href = token.attrGet("href")
                target = resolve_link(href)
                if target != href:
                    token.attrSet("href", target)
                    token.meta.pop("label", None)
    formatted = parser.renderer.render(tokens, parser.options, env)
    return parser.render(formatted)


def publish_blog_post(file, config):
    filename = os.path.basename(file).replace(".md", "")
    assert len(filename) >= 11 and filename[10] == "-"
    id = filename[11:]
    date_str = filename[:10]
    published_at = int(datetime.strptime(date_str, "%Y-%m-%d").timestamp())
    modified_at = run(f"git log -1 --format=%ct -- {file}")

    post = frontmatter.load(file)
    meta = post.metadata
    content = format_article(post.content)

    args = [
        "nak",
        "event",
        "--kind",
        "30023",
        "--created-at",
        modified_at,
        "--content",
        content,
        f"--tag=d={id}",
        f"--tag=title={meta['title']}",
        f"--tag=published_at={published_at}",
    ]

    if image := meta.get("image"):
        args.append(f"--tag=image={image}")

    if summary := meta.get("summary"):
        args.append(f"--tag=summary={summary}")

    if tags := meta.get("tags"):
        assert isinstance(tags, list)
        args += [f"--tag=t={tag}" for tag in tags]

    args += get_write_relays(config)
    subprocess.run(args, stdout=subprocess.DEVNULL)


def publish_blog(config):
    for file in glob.glob("_posts/*.md"):
        publish_blog_post(file, config)


if __name__ == "__main__":
    if "NOSTR_SECRET_KEY" not in os.environ:
        print("Error: NOSTR_SECRET_KEY environment variable is not defined.")
        sys.exit(1)
    if len(sys.argv) < 2:
        usage()
    config = load_config()
    match sys.argv[1]:
        case "profile":
            publish_profile(config)
        case "relays":
            publish_relays(config)
        case "blog":
            publish_blog(config)
        case "post":
            publish_blog_post(sys.argv[2], config)
        case _:
            usage()
